<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BaurusTour</RootNamespace>
    <AssemblyName>BaurusTour</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Imagens\icone.ico</ApplicationIcon>
    <Product>Bauru's Tour</Product>
    <StartupObject>BaurusTour.TelaInicial.FormInicial</StartupObject>
  </PropertyGroup>

  <!-- Arquivos que precisam ir junto com o .exe (pasta bin) -->
  <ItemGroup>
    <None Update="pontos.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Imagens\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Manual\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

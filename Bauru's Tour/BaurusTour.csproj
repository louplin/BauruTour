<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BaurusTour</RootNamespace>
    <AssemblyName>BaurusTour</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\icone.ico</ApplicationIcon>
    <Product>Bauru's Tour</Product>
  </PropertyGroup>

  <!-- Imagens do projeto (Projeto > Propriedades > Recursos). Aparecem no Designer. -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Arquivos que vão junto com o .exe (pasta bin) -->
  <ItemGroup>
    <None Update="pontos.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Imagens\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Manual\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

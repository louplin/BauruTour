<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BaurusTour</RootNamespace>
    <AssemblyName>BaurusTour</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\icone.ico</ApplicationIcon>
    <Product>Bauru's Tour</Product>
  </PropertyGroup>

  <!-- Imagens do projeto (Projeto > Propriedades > Recursos). Aparecem no Designer. -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Arquivos que vão junto com o .exe (pasta bin) -->
  <ItemGroup>
    <None Update="pontos.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Imagens\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Manual\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Imagens\Jardim Botânico\" />
    <Folder Include="Imagens\Horto Florestal\" />
    <Folder Include="Imagens\Bosque da comunidade\" />
    <Folder Include="Imagens\Flipper Lanches\" />
    <Folder Include="Imagens\Coisa Boa do Chef Moa\" />
    <Folder Include="Imagens\Agustina Parrila e Bar\" />
    <Folder Include="Imagens\Dona Baunilha\" />
    <Folder Include="Imagens\Catedral do Divino Espírito Santo\" />
    <Folder Include="Imagens\Ginásio SESI Vôlei Paulo Skaf\" />
    <Folder Include="Imagens\Estádio Alfredo de Castilho\" />
    <Folder Include="Imagens\Ginasio Panela de Pressão\" />
    <Folder Include="Imagens\Calçadão da Batitsta\" />
    <Folder Include="Imagens\Bauru Shopping\" />
    <Folder Include="Imagens\Boulevard Shopping\" />
    <Folder Include="Imagens\Alameda Rodoserv Center\" />
    <Folder Include="Imagens\SESC Bauru\" />
    <Folder Include="Imagens\Teatro Municipal Celina Lourdes Alves Neves\" />
    <Folder Include="Imagens\Terrazzo Cucina\" />
    <Folder Include="Imagens\Zoologico\" />
  </ItemGroup>

</Project>
